{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4174 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4174/Portfolio/home/",
        "http://localhost:4174/Portfolio/projects/",
        "http://localhost:4174/Portfolio/projects/shopnow/",
        "http://localhost:4174/Portfolio/journal/ecs-vs-eks/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.6 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
