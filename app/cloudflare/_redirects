# Cloudflare routing (Workers static assets). The site is built for
# /Portfolio/ (its GitHub Pages path, which the CMS also bakes into image
# URLs), so the Cloudflare bundle keeps it in that folder and the bare domain
# forwards to it.
/  /Portfolio/  302

# Client-side routes get the app shell with a 200 instead of the 404.html
# round-trip GitHub Pages needs. They're listed one by one because Cloudflare
# applies these rules even when a real file matches, so a catch-all like
# /Portfolio/* would also swallow /Portfolio/assets/*. Keep in sync with the
# routes in src/App.tsx.
/Portfolio/home        /Portfolio/  200
/Portfolio/projects    /Portfolio/  200
/Portfolio/skills      /Portfolio/  200
/Portfolio/experience  /Portfolio/  200
/Portfolio/journal     /Portfolio/  200
/Portfolio/gallery     /Portfolio/  200
/Portfolio/contact     /Portfolio/  200

# Dynamic rules go after the static ones.
/Portfolio/projects/*  /Portfolio/  200
