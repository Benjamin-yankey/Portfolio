# Build-time settings. Copy to .env.local for local builds; in CI they're set
# in the workflow files. All are optional.

# Where the API (worker/) lives. Leave empty for same-origin (the Cloudflare
# build). The GitHub Pages build points at the Cloudflare Worker.
VITE_API_BASE=

# Cloudflare Web Analytics token (dashboard → Web Analytics → add site).
VITE_CF_ANALYTICS_TOKEN=

# Absolute host for canonical URLs, link previews and the sitemap.
SITE_URL=https://benjamin-yankey.github.io
