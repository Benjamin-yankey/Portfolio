{
  "name": "benjamin-yankey-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cms": "GIT_REPO_DIRECTORY=.. decap-server",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "build:cloudflare": "SITE_URL=${SITE_URL:-https://benjamin-yankey-portfolio.hueywork.workers.dev} npm run build && node scripts/bundle-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "sync:github": "node scripts/sync-github.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@react-three/fiber": "^9.6.1",
    "marked": "18.1.1",
    "motion": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "decap-server": "^3.2.5",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "4.152.0"
  }
}
